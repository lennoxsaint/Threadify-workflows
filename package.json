{
  "name": "threadify-workflows",
  "version": "0.4.0",
  "description": "Public-safe, open-source workflow manifests and agent adapters for Threadify MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "threadify-workflows": "./bin/threadify-workflows.mjs"
  },
  "scripts": {
    "bundle:build": "node scripts/build-qbr-bundle.mjs",
    "bundle:check": "node scripts/build-qbr-bundle.mjs --check",
    "release:build": "node scripts/build-release-assets.mjs",
    "test:installer": "node --test validation/installer-tests/*.test.mjs",
    "validate": "node validation/schema-checks/validate.mjs && npm run bundle:check",
    "test": "npm run validate && npm run test:installer"
  },
  "engines": {
    "node": ">=18"
  }
}
