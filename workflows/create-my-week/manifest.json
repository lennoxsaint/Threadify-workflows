{
  "workflow_id": "create-my-week",
  "version": "0.1.0",
  "title": "Create My Week",
  "summary": "Plan seven days with rolling drafts by default or all drafts upfront, preserving daily review and continuation.",
  "kind": "skill",
  "entrypoint": {
    "skill_id": "threadify-create-my-week",
    "source": "skills/threadify-create-my-week/SKILL.md"
  },
  "bundle": { "kind": "creator", "standalone": false },
  "dependencies": {
    "workflows": ["create-my-day"],
    "files": ["docs/creator-system.md", "docs/creator-engine.md", "schemas/creator-records.v1.json", "schemas/creator-lifecycle.v1.json"]
  },
  "triggers": ["create my week", "plan seven days of Threads content"],
  "io": {
    "inputs": [{ "name": "creator week request", "schema_ref": "inline:creator-week-request" }],
    "outputs": [{ "name": "creator records", "schema_ref": "schemas/creator-records.v1.json" }]
  },
  "supported_adapters": [
    "generic-mcp",
    "hermes",
    "gemini",
    "codex",
    "claude",
    "openclaw",
    "cursor"
  ],
  "required_mcp_tools": [],
  "optional_mcp_tools": [
    "get_connection_defaults",
    "greatest_hits",
    "list_viral_items",
    "get_viral_item",
    "list_vault_items",
    "get_vault_item",
    "generate_content",
    "save_draft",
    "validate_post",
    "list_scheduled_posts",
    "schedule_post",
    "get_schedule_status"
  ],
  "free_capabilities": [
    "local source review",
    "host-authored drafts from confirmed facts",
    "private local records and continuation",
    "exact owner review"
  ],
  "paid_capability_stubs": [
    "Brain personalization and shared corpus remain hosted; use only currently entitled connected tools"
  ],
  "approval_gate": {
    "required": true,
    "type": "explicit-final-approval",
    "must_show": [
      "source links",
      "adaptation mode",
      "gaps",
      "exact copy and media",
      "account",
      "timezone",
      "proposed times",
      "exact action"
    ]
  },
  "fallback": {
    "mode": "local-only",
    "artifact_schema": "creator-review.v1",
    "instructions": [
      "Keep useful local work from user-supplied sources and verified facts.",
      "Identify unavailable connection, Brain, hosted storage and scheduling.",
      "Do not invent imports, saved drafts, provider validation or delivery."
    ]
  },
  "receipt": {
    "schema": "creator-records.v1",
    "must_prove": [
      "workflow ID",
      "exact reviewed material",
      "approval state",
      "fallback state",
      "local versus provider evidence",
      "unresolved attempts"
    ]
  }
}
