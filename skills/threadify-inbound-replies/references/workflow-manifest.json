{
  "workflow_id": "inbound-replies",
  "version": "0.2.0",
  "title": "Threadify Inbound Replies",
  "summary": "Review Threads inbound grouped beneath its source post, preserve exact edits locally, and use only a currently advertised Threadify delivery capability for an explicitly approved reply set.",
  "kind": "skill",
  "entrypoint": {
    "skill_id": "threadify-inbound-replies",
    "source": "plugins/threadify/skills/threadify-inbound-replies/SKILL.md"
  },
  "bundle": {
    "kind": "advanced",
    "standalone": false,
    "references": [
      { "source": "workflows/inbound-replies/CONTRACT.md", "target": "references/inbound-contract.md" },
      { "source": "tools/inbound/cli.mjs", "target": "scripts/cli.mjs" },
      { "source": "tools/inbound/store.mjs", "target": "scripts/store.mjs" },
      { "source": "tools/inbound/server.mjs", "target": "scripts/server.mjs" },
      { "source": "tools/inbound/app.js", "target": "scripts/app.js" },
      { "source": "tools/inbound/index.html", "target": "scripts/index.html" },
      { "source": "tools/inbound/style.css", "target": "scripts/style.css" }
    ]
  },
  "dependencies": {
    "workflows": [],
    "files": [
      "workflows/inbound-replies/README.md",
      "workflows/inbound-replies/CONTRACT.md"
    ]
  },
  "triggers": [
    "review my Threads reply backlog",
    "use Threadify inbound replies"
  ],
  "io": {
    "inputs": [{ "name": "bounded Threads inbound timeframe", "schema_ref": "inline:inbound-timeframe" }],
    "outputs": [{ "name": "private grouped reply review receipt", "schema_ref": "schemas/workflow-receipt.v1.json" }]
  },
  "supported_adapters": ["generic-mcp", "codex", "claude", "cursor", "hermes", "gemini", "openclaw"],
  "required_mcp_tools": [],
  "optional_mcp_tools": ["get_connection_defaults", "list_dispatcher_tools", "call_agent_action", "query_brain", "record_feedback"],
  "free_capabilities": ["private grouped review", "exact edit and revision tracking", "interrupted-batch recovery", "body-free receipts"],
  "paid_capability_stubs": ["current connected-account discovery, drafting and delivery actions when advertised by Threadify"],
  "approval_gate": {"required": true, "type": "explicit-final-approval", "must_show": ["account handle", "exact final reply", "native target", "action", "fallback state"]},
  "fallback": {"mode": "local-review", "artifact_schema": "inbound-packet.v1", "instructions": ["Guide OAuth setup when MCP is missing. Do not claim discovery or publication.", "Accept only user-supplied or visibly authenticated read-only source snapshots when no current Threadify discovery action is advertised.", "Use the local editor when native Writing-block edit readback is unavailable.", "Use context-grounded agent drafts only with complete source context.", "Keep unavailable delivery local; keep uncertain sends pending for independent reconciliation and never retry blindly."]},
  "receipt": {"schema": "workflow-receipt.v1", "must_prove": ["account handle", "source binding", "approved revision and text hash", "send receipt", "published reply readback", "feedback receipt", "coverage", "fallback state"]}
}
