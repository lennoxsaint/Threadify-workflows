{
  "workflow_id": "greatest-hits-runway",
  "version": "0.1.0",
  "title": "Greatest Hits Runway",
  "summary": "Public orchestration for Greatest Hits Runway, with review, exact approval and readback.",
  "kind": "skill",
  "entrypoint": {
    "skill_id": "threadify-greatest-hits-runway",
    "source": "plugins/threadify/skills/threadify-greatest-hits-runway/SKILL.md"
  },
  "bundle": { "kind": "advanced", "standalone": false },
  "dependencies": { "workflows": [], "files": ["workflows/greatest-hits-runway/README.md"] },
  "triggers": ["prepare my greatest hits runway", "review a seven-day runway of proven posts"],
  "io": {
    "inputs": [{ "name": "greatest-hits selection", "schema_ref": "inline:greatest-hits-selection" }],
    "outputs": [{ "name": "runway receipt", "schema_ref": "schemas/workflow-receipt.v1.json" }]
  },
  "supported_adapters": [
    "generic-mcp",
    "codex",
    "claude",
    "hermes",
    "gemini",
    "openclaw",
    "cursor"
  ],
  "required_mcp_tools": [],
  "optional_mcp_tools": [
    "get_connection_defaults",
    "plan_greatest_hits_runway",
    "list_scheduled_posts",
    "validate_post",
    "schedule_post",
    "get_schedule_status"
  ],
  "free_capabilities": [
    "local review and preparation from approved sources"
  ],
  "paid_capability_stubs": [
    "Hosted Threadify tools require current connection scopes and plan entitlement"
  ],
  "approval_gate": {
    "required": true,
    "type": "explicit-final-approval",
    "must_show": [
      "account",
      "exact payload",
      "action",
      "time or memory category",
      "source and changed facts"
    ]
  },
  "fallback": {
    "mode": "local-review-packet",
    "instructions": [
      "Use approved local source material when provider tools are unavailable.",
      "Keep provider operations not attempted and report exact setup or entitlement gaps."
    ]
  },
  "receipt": {
    "schema": "workflow-receipt.v1",
    "must_prove": [
      "account",
      "source",
      "approved payload",
      "actual operation",
      "readback",
      "fallback state"
    ]
  }
}
