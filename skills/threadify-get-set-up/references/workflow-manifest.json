{
  "workflow_id": "get-set-up",
  "version": "0.1.0",
  "title": "Get Set Up",
  "summary": "Go from signup to a personalized Brain, first week and verified agent routine.",
  "kind": "skill",
  "entrypoint": {
    "skill_id": "threadify-get-set-up",
    "source": "plugins/threadify/skills/threadify-get-set-up/SKILL.md"
  },
  "bundle": {
    "kind": "advanced",
    "standalone": false,
    "references": [
      {
        "source": "docs/customer-setup.md",
        "target": "references/setup-guide.md"
      },
      {
        "source": "docs/setup-adapters.md",
        "target": "references/setup-adapters.md"
      }
    ]
  },
  "dependencies": {
    "workflows": [
      "create-my-week",
      "vault-setup"
    ],
    "files": [
      "docs/customer-setup.md",
      "docs/setup-adapters.md",
      "lib/onboarding/setup.mjs"
    ]
  },
  "triggers": [
    "set up Threadify",
    "get me started with Threadify",
    "resume my Threadify setup"
  ],
  "io": {
    "inputs": [
      {
        "name": "setup request",
        "schema_ref": "inline:setup-request"
      }
    ],
    "outputs": [
      {
        "name": "private setup status",
        "schema_ref": "inline:setup-status"
      }
    ]
  },
  "supported_adapters": [
    "generic-mcp",
    "hermes",
    "gemini",
    "codex",
    "claude",
    "openclaw",
    "cursor"
  ],
  "required_mcp_tools": [],
  "optional_mcp_tools": [
    "get_connection_defaults",
    "greatest_hits",
    "list_viral_items",
    "get_viral_item",
    "list_vault_items",
    "get_vault_item",
    "generate_content",
    "save_draft",
    "validate_post",
    "list_scheduled_posts",
    "schedule_post",
    "get_schedule_status",
    "remember",
    "ingest_brain_source",
    "query_brain",
    "list_offers"
  ],
  "free_capabilities": [
    "local source review",
    "host-authored drafts from confirmed facts",
    "private local records and continuation",
    "exact owner review"
  ],
  "paid_capability_stubs": [
    "Brain personalization and shared corpus remain hosted; use only currently entitled connected tools"
  ],
  "approval_gate": {
    "required": true,
    "type": "explicit-final-approval",
    "must_show": [
      "source links",
      "adaptation mode",
      "gaps",
      "exact copy and media",
      "account",
      "timezone",
      "proposed times",
      "exact action"
    ]
  },
  "fallback": {
    "mode": "local-only",
    "artifact_schema": "creator-review.v1",
    "instructions": [
      "Keep useful local work from user-supplied sources and verified facts.",
      "Identify unavailable connection, Brain, hosted storage and scheduling.",
      "Do not invent imports, saved drafts, provider validation or delivery."
    ]
  },
  "receipt": {
    "schema": "creator-records.v1",
    "must_prove": [
      "workflow ID",
      "exact reviewed material",
      "approval state",
      "fallback state",
      "local versus provider evidence",
      "unresolved attempts"
    ]
  }
}
