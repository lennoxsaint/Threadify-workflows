{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadify.app/schemas/post-this-next.v1.json",
  "title": "Post This Next result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "generated_at",
    "account_label",
    "snapshot_sha256",
    "eligible_draft_count",
    "excluded_draft_count",
    "goals",
    "provider",
    "thresholds",
    "claims",
    "external_actions_performed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "const": "post-this-next" },
    "generated_at": { "type": "string", "minLength": 1 },
    "account_label": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "eligible_draft_count": { "type": "integer", "minimum": 1 },
    "excluded_draft_count": { "type": "integer", "minimum": 0 },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "most_useful_now": { "$ref": "#/$defs/decision" },
        "engagement_pattern_fit": { "$ref": "#/$defs/decision" },
        "closest_to_ready": { "$ref": "#/$defs/decision" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model", "privacy_route", "cost_usd", "latency_ms"],
      "properties": {
        "adapter": { "enum": ["custom_jev", "jev_code", "compatible_jev", "manual"] },
        "model": { "type": ["string", "null"] },
        "privacy_route": { "enum": ["zdr", "non_zdr_owner_approved", "local_only"] },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clear_confidence", "clear_margin_points", "calibration_status"],
      "properties": {
        "clear_confidence": { "const": 0.8 },
        "clear_margin_points": { "const": 10 },
        "calibration_status": { "const": "provisional_advisory_only" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traffic_prediction", "engagement_language"],
      "properties": {
        "traffic_prediction": { "const": false },
        "engagement_language": { "type": "string", "minLength": 1 }
      }
    },
    "external_actions_performed": { "const": false }
  },
  "$defs": {
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "content_sha256", "normalized_score", "min_confidence"],
      "properties": {
        "draft_id": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "normalized_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "min_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommended_draft_id",
        "runner_up_draft_id",
        "top_two_draft_ids",
        "lead_points",
        "abstention_reason",
        "rankings"
      ],
      "properties": {
        "status": { "enum": ["recommended", "abstained", "only_candidate", "manual_shortlist"] },
        "recommended_draft_id": { "type": ["string", "null"] },
        "runner_up_draft_id": { "type": ["string", "null"] },
        "top_two_draft_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lead_points": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "abstention_reason": { "type": ["string", "null"] },
        "rankings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ranking" }
        }
      }
    }
  }
}
