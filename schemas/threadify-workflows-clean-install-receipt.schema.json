{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "THREADIFY-021 Threadify Workflows v0.6.0 clean-install receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "schema_version", "receipt_kind", "observed_at", "repository", "tag",
    "package_version", "commit_sha", "install_path", "privacy_inventory_sha256",
    "clean_install_passed", "bundled_viral_carousel_maker_version",
    "bundled_viral_carousel_maker_commit_sha", "bundled_demo_contract_sha256",
    "one_install_passed", "ordered_carousel_media_tests_passed",
    "wrong_account_rejection_tests_passed", "absent_capability_tests_passed",
    "occupied_slot_tests_passed", "stale_approval_tests_passed",
    "separate_transfer_and_schedule_approval_tests_passed", "crash_recovery_tests_passed",
    "ambiguous_outcome_and_duplicate_prevention_tests_passed", "threadify_mcp_calls",
    "provider_writes", "external_actions"
  ],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "threadify_workflows_v0_6_0_clean_install"},
    "observed_at": {"type": "string", "format": "date-time"},
    "repository": {"const": "https://github.com/lennoxsaint/Threadify-workflows.git"},
    "tag": {"const": "v0.6.0"},
    "package_version": {"const": "0.6.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "install_path": {"type": "string", "minLength": 1},
    "privacy_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clean_install_passed": {"const": true},
    "bundled_viral_carousel_maker_version": {"const": "0.2.0"},
    "bundled_viral_carousel_maker_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "bundled_demo_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "one_install_passed": {"const": true},
    "ordered_carousel_media_tests_passed": {"const": true},
    "wrong_account_rejection_tests_passed": {"const": true},
    "absent_capability_tests_passed": {"const": true},
    "occupied_slot_tests_passed": {"const": true},
    "stale_approval_tests_passed": {"const": true},
    "separate_transfer_and_schedule_approval_tests_passed": {"const": true},
    "crash_recovery_tests_passed": {"const": true},
    "ambiguous_outcome_and_duplicate_prevention_tests_passed": {"const": true},
    "threadify_mcp_calls": {"const": 0},
    "provider_writes": {"const": 0},
    "external_actions": {"const": 0}
  }
}
