{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadify.app/schemas/workflow-manifest.v1.json",
  "title": "Threadify Workflow Manifest",
  "type": "object",
  "required": [
    "workflow_id",
    "version",
    "title",
    "summary",
    "kind",
    "entrypoint",
    "bundle",
    "dependencies",
    "triggers",
    "io",
    "supported_adapters",
    "required_mcp_tools",
    "free_capabilities",
    "paid_capability_stubs",
    "approval_gate",
    "fallback",
    "receipt"
  ],
  "properties": {
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "kind": { "enum": ["skill", "recipe"] },
    "entrypoint": {
      "type": "object",
      "required": ["skill_id", "source"],
      "additionalProperties": false,
      "properties": {
        "skill_id": { "type": ["string", "null"], "pattern": "^threadify-[a-z0-9-]+$" },
        "source": { "type": "string", "pattern": "^(plugins/threadify/skills|skills|workflows)/.+" }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["kind", "standalone"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["creator", "advanced", "conversation", "recipe"] },
        "standalone": { "type": "boolean" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["workflows", "files"],
      "additionalProperties": false,
      "properties": {
        "workflows": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
        "files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "triggers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "io": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "inputs": { "$ref": "#/$defs/ioRecords" },
        "outputs": { "$ref": "#/$defs/ioRecords" }
      }
    },
    "supported_adapters": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "required_mcp_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "optional_mcp_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "free_capabilities": { "type": "array", "items": { "type": "string" } },
    "paid_capability_stubs": { "type": "array", "items": { "type": "string" } },
    "approval_gate": {
      "type": "object",
      "required": ["required", "type", "must_show"],
      "properties": {
        "required": { "type": "boolean" },
        "type": { "type": "string" },
        "must_show": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["mode", "instructions"],
      "properties": {
        "mode": { "type": "string" },
        "artifact_schema": { "type": "string" },
        "instructions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["schema", "must_prove"],
      "properties": {
        "schema": { "type": "string" },
        "must_prove": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  },
  "$defs": {
    "ioRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "schema_ref"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "schema_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
