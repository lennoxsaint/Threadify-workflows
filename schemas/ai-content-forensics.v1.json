{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadify.app/schemas/ai-content-forensics.v1.json",
  "title": "AI Content Forensics packet",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/output" }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "required": ["record_type", "schema_version", "run_id", "creator", "destination_platform", "observed_at", "sources", "items", "finding_candidates", "hook", "action_post", "cta_post"],
      "properties": {
        "record_type": { "const": "AIContentForensicsInputV1" },
        "schema_version": { "const": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "creator": {
          "type": "object",
          "required": ["display_name", "handle"],
          "properties": {
            "display_name": { "type": "string", "minLength": 1 },
            "handle": { "type": "string", "minLength": 1 },
            "publisher_handle": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "destination_platform": { "enum": ["threads", "x", "linkedin", "bluesky"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
        "finding_candidates": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/finding" } },
        "hook": { "type": "string", "minLength": 1 },
        "action_post": { "type": "string", "minLength": 1 },
        "cta_post": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "provider", "platform", "auth_mode", "observed_at", "requested_count", "returned_count", "complete", "evidence_ref"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "auth_mode": { "enum": ["local_export", "public", "owned_account", "byo_key"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "requested_count": { "type": "integer", "minimum": 0 },
        "returned_count": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "cache_status": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["evidence_id", "source_id", "platform", "creator_handle", "native_id", "published_at", "format_family", "text", "metrics", "source_kind", "rights_basis"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "source_id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "creator_handle": { "type": "string", "minLength": 1 },
        "native_id": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "published_at": { "type": "string", "format": "date-time" },
        "format_family": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "metrics": {
          "type": "object",
          "properties": {
            "views": { "type": ["integer", "null"], "minimum": 0 },
            "likes": { "type": ["integer", "null"], "minimum": 0 },
            "replies": { "type": ["integer", "null"], "minimum": 0 },
            "reposts": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "source_kind": { "enum": ["owned", "public", "licensed", "permissioned"] },
        "rights_basis": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "rank", "category", "claim", "explanation", "copy_this", "evidence_ids", "limitation"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "rank": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["opener", "proof", "structure", "media", "cta"] },
        "claim": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "copy_this": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["record_type", "schema_version", "run_id", "status", "coverage", "constitutions", "insight_audit", "thread", "receipt"],
      "properties": {
        "record_type": { "const": "AIContentForensicsOutputV1" },
        "schema_version": { "const": 1 },
        "run_id": { "type": "string" },
        "status": { "const": "prepared_locally" },
        "coverage": { "type": "object" },
        "constitutions": { "type": "object" },
        "insight_audit": { "type": "object" },
        "thread": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "string" } },
        "receipt": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
